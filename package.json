{
  "name": "tangleflow-coverage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "coverage:scan": "node coverage/cli.ts scan",
    "coverage:report": "node coverage/cli.ts report",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && oxfmt --check '**/*.ts'",
    "format": "oxfmt --write '**/*.ts'"
  },
  "dependencies": {
    "@atcute/lexicons": "2.1.0",
    "@atproto/identity": "0.5.13",
    "tangleflow": "0.7.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@atcute/tangled": "2.0.19",
    "@types/node": "26.5.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
