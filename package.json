{
  "name": "tangled-migration-scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "scan": "node src/scan.ts",
    "report": "node src/report.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src && oxfmt --check src",
    "format": "oxfmt --write src"
  },
  "dependencies": {
    "@atproto/identity": "0.5.13",
    "tangleflow": "0.7.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@atcute/atproto": "4.0.4",
    "@atcute/lexicons": "2.1.0",
    "@atcute/tangled": "2.0.19",
    "@types/node": "26.5.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
