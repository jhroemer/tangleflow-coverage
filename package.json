  },
  "dependencies": {
    "tangleflow": "0.7.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typescript": "7.0.2"
  }
}
